<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      THE ONLY PERMISSION THIS APP ASKS FOR.

      Until issue #21 the release build declared nothing at all, and that was
      logged as the clearest possible proof of the offline claim: it could not
      reach the network even if a future line of code tried.

      Offline maps make that impossible. Routes, places and tiles have to come
      from somewhere, once, before you leave. So the claim is now narrower and
      it has to be stated honestly: the app is offline WHILE YOU ARE MOVING,
      not offline absolutely. It reaches the network only on a screen you
      opened, after a button that says what it is about to fetch and from whom,
      and never once the trip has started.

      Anything weaker than that — a background refresh, a silent retry on the
      road, a "just checking for updates" — breaks the promise the whole app is
      built on. There is no other permission here, and there is no background
      service, precisely so that stays checkable.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:label="SafarSathi"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <!--
      PACKAGE VISIBILITY. On Android 11 and later an app cannot see which
      other apps handle an intent unless it declares the intent here. Without
      these, url_launcher returns false for tel:, sms: and https: and every
      action on the entry screen fails silently — on the exact phones this app
      is meant for.

      These are queries, not permissions. The one permission this app holds is
      declared at the top of this file, and the paragraph there says why.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Opening the dialer, with a number and without one. -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="tel"/>
        </intent>
        <!-- SMS. -->
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="smsto"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="sms"/>
        </intent>
        <!-- wa.me, and any deep link out to a map. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
